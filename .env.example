# 复制成 .env 再填写. .env 已经在 .gitignore 里, 不会被提交
# 模型服务商: deepseek-anthropic (Anthropic 兼容接口) 或 deepseek-openai (还没有实现, 见 docs/decisions.md 的已知的局限)
LLM_PROVIDER=deepseek-anthropic
DEEPSEEK_API_KEY=
DEEPSEEK_ANTHROPIC_BASE_URL=
# 可选: 不填时用服务商的默认模型
LLM_MODEL=

# 可选: 创建目标仓库虚拟环境用的 Python (版本要和题目要求的一致), 不填时用运行 bumpwise 的这个 Python
BUMPWISE_PYTHON=
# 可选: 一次运行的 token 预算和轮数上限 (轮数只是断路器)
BUMPWISE_TOKEN_BUDGET=
BUMPWISE_MAX_TURNS=
